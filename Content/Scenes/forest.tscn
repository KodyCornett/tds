[sub_resource type="GDScript" id="GDScript_54tir"]
script/source = "class_name TreeNode
extends StaticBody2D

@export var health: float = 25
@export var wood_drop: int = 3
@export var stump_texture: Texture2D  # assign your stump in inspector

@onready var sprite: Sprite2D = $Sprite2D
@onready var area: Area2D = $Area2D

func _ready():
	add_to_group(\"trees\")

func take_damage(amount: float) -> void:
	health -= amount
	print(\"[TreeNode] Hit! Damage taken:\", amount, \"| Remaining health:\", health)

	# --- Visual feedback ---
	sprite.modulate = Color(1, 0.5, 0.5)
	await get_tree().create_timer(0.1).timeout
	sprite.modulate = Color(1, 1, 1)

	if health <= 0:
		harvest()

func harvest() -> void:
	print(\"[TreeNode] Harvested! Wood added:\", wood_drop)
	if stump_texture:
		sprite.texture = stump_texture
	area.monitoring = false  # disable further chops
	Inventory.add_item(\"wood\", wood_drop)
"

