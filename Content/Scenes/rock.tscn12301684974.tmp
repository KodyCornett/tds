[sub_resource type="GDScript" id="GDScript_v3srh"]
script/source = "extends StaticBody2D


@export var rock_name: String = \"Stone\"
@export var max_health: int = 5
@export var drops: Array[String] = [\"stone\"]

var health: int

@onready var sprite: Sprite2D = $RockSprite2D
@onready var collision: CollisionShape2D = $CollisionShape2D

func _ready() -> void:
	health = max_health
	add_to_group(\"rocks\")

func take_damage(amount: int) -> void:
	print(\"[Rock] take_damage called! Amount:\", amount, \"Health before:\", health)
	health -= amount
	print(\"[Rock] Health now:\", health)
	flash_hit()

	if health <= 0:
		break_rock()

func flash_hit() -> void:
	if not sprite: return
	sprite.modulate = Color(1, 0.5, 0.5)  # reddish tint
	await get_tree().create_timer(0.1).timeout
	sprite.modulate = Color(1, 1, 1)      # reset to normal   

func break_rock() -> void:
	print(\"%s has been mined!\" % rock_name)
	for drop in drops:
		if ItemDatabase.ITEMS.has(drop):
			Inventory.add_item(drop, 1)
			print(\"Dropped:\", drop)
		else:
			push_warning(\"Unknown drop id: %s\" % drop)

	# Hide & disable collisions
	sprite.hide()
	collision.set_deferred(\"disabled\", true)
	queue_free()
"

